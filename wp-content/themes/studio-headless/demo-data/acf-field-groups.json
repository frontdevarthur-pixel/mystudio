          },
          {
            "key": "field_stat_value",
            "label": "Значение",
            "name": "value",
            "type": "number",
            "parent": "field_about_stats"
          },
          {
            "key": "field_stat_suffix",
            "label": "Суффикс",
            "name": "suffix",
            "type": "text",
            "placeholder": "+",
            "parent": "field_about_stats"
          }
        ]
      }
    ],
    "location": [
      [
        {
          "param": "options_page",
          "operator": "==",
          "value": "about-section"
        }
      ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "description": ""
