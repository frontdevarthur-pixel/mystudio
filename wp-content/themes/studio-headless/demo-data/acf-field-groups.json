[
  {
    "key": "group_studio_settings",
    "title": "Настройки студии",
    "fields": [
      {
        "key": "field_site_name",
        "label": "Название сайта",
        "name": "site_name",
        "type": "text",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_logo",
        "label": "Логотип",
        "name": "logo",
        "type": "image",
        "return_format": "array",
        "preview_size": "medium",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_favicon",
        "label": "Фавиконка",
        "name": "favicon",
        "type": "image",
        "return_format": "array",
        "preview_size": "thumbnail",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_email",
        "label": "Email",
        "name": "email",
        "type": "email",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_phone",
        "label": "Телефон",
        "name": "phone",
        "type": "text",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_address",
        "label": "Адрес",
        "name": "address",
        "type": "textarea",
        "rows": 3,
        "parent": "group_studio_settings"
      },
      {
        "key": "field_social_links",
        "label": "Социальные сети",
        "name": "social_links",
        "type": "repeater",
        "layout": "table",
        "button_label": "Добавить ссылку",
        "parent": "group_studio_settings",
        "sub_fields": [
          {
            "key": "field_social_platform",
            "label": "Платформа",
            "name": "platform",
            "type": "text",
            "parent": "field_social_links"
          },
          {
            "key": "field_social_url",
            "label": "URL",
            "name": "url",
            "type": "url",
            "parent": "field_social_links"
          },
          {
            "key": "field_social_label",
            "label": "Метка",
            "name": "label",
            "type": "text",
            "parent": "field_social_links"
          }
        ]
      },
      {
        "key": "field_seo_title",
        "label": "SEO-заголовок",
        "name": "seo_title",
        "type": "text",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_seo_description",
        "label": "SEO-описание",
        "name": "seo_description",
        "type": "textarea",
        "rows": 3,
        "parent": "group_studio_settings"
      },
      {
        "key": "field_og_image",
        "label": "OG-изображение",
        "name": "og_image",
        "type": "image",
        "return_format": "array",
        "preview_size": "medium",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_twitter_card",
        "label": "Twitter Card",
        "name": "twitter_card",
        "type": "select",
        "choices": {
          "summary": "Summary",
          "summary_large_image": "Summary Large Image"
        },
        "default_value": "summary_large_image",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_map_lat",
        "label": "Широта (latitude)",
        "name": "map_lat",
        "type": "number",
        "step": "any",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_map_lng",
        "label": "Долгота (longitude)",
        "name": "map_lng",
        "type": "number",
        "step": "any",
        "parent": "group_studio_settings"
      },
      {
        "key": "field_office_marker_label",
        "label": "Метка маркера на карте",
        "name": "office_marker_label",
        "type": "text",
        "parent": "group_studio_settings"
      }
    ],
    "location": [
      [
        {
          "param": "options_page",
          "operator": "==",
          "value": "studio-settings"
        }
      ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "description": ""
  },
  {
    "key": "group_hero_section",
    "title": "Hero-секция",
    "fields": [
      {
        "key": "field_hero_heading",
        "label": "Заголовок",
        "name": "heading",
        "type": "text",
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_subheading",
        "label": "Подзаголовок",
        "name": "subheading",
        "type": "textarea",
        "rows": 3,
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_cta_text",
        "label": "Текст кнопки CTA",
        "name": "cta_text",
        "type": "text",
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_cta_anchor",
        "label": "Якорь кнопки CTA",
        "name": "cta_anchor",
        "type": "text",
        "placeholder": "#contact",
        "instructions": "Якорная ссылка, например #contact или #portfolio",
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_background_type",
        "label": "Тип фона",
        "name": "background_type",
        "type": "select",
        "choices": {
          "gradient": "Градиент",
          "image": "Изображение",
          "video": "Видео"
        },
        "default_value": "gradient",
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_background_gradient",
        "label": "CSS-градиент фона",
        "name": "background_gradient",
        "type": "text",
        "placeholder": "linear-gradient(135deg, #1a1a2e 0%, #16213e 100%)",
        "conditional_logic": [
          [
            {
              "field": "field_hero_background_type",
              "operator": "==",
              "value": "gradient"
            }
          ]
        ],
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_background_image",
        "label": "Фоновое изображение",
        "name": "background_image",
        "type": "image",
        "return_format": "array",
        "preview_size": "medium",
        "conditional_logic": [
          [
            {
              "field": "field_hero_background_type",
              "operator": "==",
              "value": "image"
            }
          ]
        ],
        "parent": "group_hero_section"
      },
      {
        "key": "field_hero_background_video",
        "label": "Фоновое видео",
        "name": "background_video",
        "type": "file",
        "return_format": "array",
        "mime_types": "mp4,webm",
        "conditional_logic": [
          [
            {
              "field": "field_hero_background_type",
              "operator": "==",
              "value": "video"
            }
          ]
        ],
        "parent": "group_hero_section"
      }
    ],
    "location": [
      [
        {
          "param": "options_page",
          "operator": "==",
          "value": "hero-section"
        }
      ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "active": true,
    "description": ""
  },
