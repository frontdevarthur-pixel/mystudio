# URL WordPress REST API (базовый URL для Axios-клиента)
# Пример: https://cms.yourdomain.ru/wp-json/studio/v1
NEXT_PUBLIC_API_URL=https://cms.yourdomain.ru/wp-json/studio/v1

# Публичный URL Next.js-сайта (используется в sitemap и JSON-LD)
# Пример: https://yourdomain.ru
NEXT_PUBLIC_SITE_URL=https://yourdomain.ru

# Секрет для ISR-регенерации (должен совпадать с NEXTJS_REVALIDATE_SECRET в wp-config.php)
# Сгенерировать: openssl rand -hex 32
REVALIDATE_SECRET=your_revalidate_secret_here

# API-ключ Google Maps (опционально, если используется Google Maps вместо Leaflet)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
